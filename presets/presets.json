        {"etype": "DIPOLE_SECTOR", "label": "B2", "params": {"L": 1.0, "theta": 0.15, "e1": 0.0, "e2": 0.0}, "thin": false, "annotation": ""}
      ]
    },
    {
      "name": "Final Focus Triplet",
